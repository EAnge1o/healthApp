# ===================================================
# 健康管理App 后端环境变量模板
# 使用方式：复制本文件为 .env 并填写真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，请勿提交真实密钥
# ===================================================

# ===== 数据库配置（MySQL）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=health_app

# ===== JWT 认证 =====
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# ===== 服务端口 =====
PORT=3000

# ===== 百度 AI 开放平台（拍照/条形码菜品识别）=====
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key
BAIDU_DISH_API_URL=https://aip.baidubce.com/rest/2.0/image-classify/v2/dish
BAIDU_BARCODE_API_URL=https://aip.baidubce.com/rest/2.0/image-classify/v1/barcode

# ===== 豆包 Doubao（AI 健康分析）=====
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=doubao-1-5-lite-32k-250115
